.d-badge--warning{background:#fef3c7;color:#92400e}
.d-badge--danger {background:#ffe4e6;color:#9f1239}
.d-badge--info   {background:#e0f2fe;color:#0369a1}

/* ── Score ── */
.d-score{display:inline-flex;align-items:center;justify-content:center;min-width:36px;padding:4px 10px;border-radius:7px;font-size:.9rem;font-weight:800}
.d-score--green{background:#d1fae5;color:#065f46}
.d-score--sky  {background:#e0f2fe;color:#0369a1}
.d-score--rose {background:#ffe4e6;color:#9f1239}

/* ── Quick Grid ── */
.d-quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.d-quick{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px;border-radius:11px;text-decoration:none;font-size:.75rem;font-weight:700;transition:all .2s;text-align:center;border:2px solid transparent}
.d-quick:hover{border-color:currentColor;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.d-quick--sky   {background:#e0f2fe;color:#0369a1}
.d-quick--amber {background:#fef3c7;color:#92400e}
.d-quick--rose  {background:#ffe4e6;color:#9f1239}
.d-quick--violet{background:#ede9fe;color:#4c1d95}
.d-quick--slate {background:#f1f5f9;color:#334155}
.d-quick--green {background:#d1fae5;color:#065f46}

/* ── Buttons ── */
.d-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:.8rem;font-weight:700;border:none;cursor:pointer;text-decoration:none;transition:all .2s}
.d-btn--block{width:100%}
.d-btn--sky  {background:#0ea5e9;color:#fff} .d-btn--sky:hover  {background:#0284c7;color:#fff}
.d-btn--amber{background:#d97706;color:#fff} .d-btn--amber:hover{background:#b45309;color:#fff}
.d-btn--rose {background:#e11d48;color:#fff} .d-btn--rose:hover {background:#be123c;color:#fff}

/* ── Misc ── */
.d-muted{color:#9ca3af;font-size:.78rem}
.d-empty{padding:16px;color:#9ca3af;font-size:.83rem}
.badge-lg{font-size:1.2rem;padding:.5rem .8rem}
